+        << ",\"vocab_size\":\"" << c.vocab_size << "\",\"context_length\":\"" << c.context_length << "\""
+        << ",\"rope_theta\":\"" << c.rope_theta << "\",\"rms_eps\":\"" << c.rms_eps << "\""
