+// 2026-10-17: one 16-byte global load / store of a LossVec<T>, through uint4.
+// bfloat16_t and float16_t have a user-written copy constructor, so LossVec<T>
+// is not trivially copyable for them, and `vec_t in = logits_v[v]` compiled to
+// EIGHT 2-byte loads (LDG.E.U16) and the store to eight 2-byte stores
+// (STG.E.U16): the SASS of sparseCENormalize_from_stats<bfloat16_t, uint16_t>.
+// The float instantiation was one LDG.E.128 / STG.E.128. Here the 16 bytes move
+// as one uint4 and memcpy only moves registers. Same bits in, same bits out.
+template <typename T>
+__device__ __forceinline__ LossVec<T> loss_ld16(const LossVec<T> *p) {
+  const uint4 raw = *reinterpret_cast<const uint4 *>(p);
+  LossVec<T> r;
+  ::std::memcpy(&r, &raw, sizeof(raw));
+  return r;
+}
+template <typename T>
+__device__ __forceinline__ void loss_st16(LossVec<T> *p, const LossVec<T> &r) {
+  uint4 raw;
+  ::std::memcpy(&raw, &r, sizeof(raw));
+  *reinterpret_cast<uint4 *>(p) = raw;
+}
