+// 2026-10-31: a copy that does not fit 32 bits is cut along its outermost dimension into pieces that do (like PyTorch's
+// TensorIterator::with_32bit_indexing); each piece takes the same path as the whole copy with the 32-bit kernels.
+// Returns false when one outer slice alone does not fit (the caller then runs its 64-bit kernels).
+static bool split_copy_32(const void* src, void* dst, int64_t total_elems, const int64_t* dims_in, const int64_t* strides_in,
+                          int32_t ndim_in, int64_t storage_offset, int32_t elem_size, cudaStream_t stream, bool generic,
+                          void (*entry)(const void*, void*, int64_t, const int64_t*, const int64_t*, int32_t, int64_t, int32_t, cudaStream_t))
+{
+    constexpr int64_t kLim = 2147483647;
+    if (ndim_in > 16) return false;   // runs before the dispatcher's own ndim check; the arrays below hold 16
+    int64_t dims[16], strides[16];
+    int ndim = ndim_in;
+    for (int i = 0; i < ndim; ++i) { dims[i] = dims_in[i]; strides[i] = strides_in[i]; }
+    // the same merge of contiguous runs as the dispatchers (only valid at offset 0)
+    if (storage_offset == 0 && ndim > 1) {
+        int w = 0;
+        for (int r = 1; r < ndim; ++r) {
+            if (strides[w] == dims[r] * strides[r]) { dims[w] *= dims[r]; strides[w] = strides[r]; }
+            else { ++w; dims[w] = dims[r]; strides[w] = strides[r]; }
+        }
+        ndim = w + 1;
+    }
+    int64_t span = storage_offset + 1;
+    for (int d = 0; d < ndim; ++d) span += (dims[d] - 1) * strides[d];
+    if (total_elems < kLim && span < kLim) return false;   // fits: not ours
+    if (ndim < 2 || dims[0] < 2) return false;
+    const int64_t inner = total_elems / dims[0];
+    int64_t inner_span = 1;
+    for (int d = 1; d < ndim; ++d) inner_span += (dims[d] - 1) * strides[d];
+    if (inner >= kLim || storage_offset + inner_span >= kLim) return false;
+    int64_t chunk = (kLim - 1) / inner;
+    if (strides[0] > 0) chunk = std::min<int64_t>(chunk, (kLim - 1 - storage_offset - inner_span) / strides[0] + 1);
+    if (chunk < 1) return false;
+    const char* s = static_cast<const char*>(src);
+    char* o = static_cast<char*>(dst);
+    for (int64_t b = 0; b < dims[0]; b += chunk) {
+        const int64_t len = std::min<int64_t>(chunk, dims[0] - b);
+        int64_t d2[16];
+        for (int d = 0; d < ndim; ++d) d2[d] = dims[d];
+        d2[0] = len;
+        entry(s + b * strides[0] * elem_size, o + b * inner * elem_size, len * inner, d2, strides, ndim, storage_offset,
+              elem_size, stream);
+    }
+    (void)generic;
+    return true;
+}
