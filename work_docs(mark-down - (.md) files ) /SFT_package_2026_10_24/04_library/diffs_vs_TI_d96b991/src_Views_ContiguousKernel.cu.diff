+// 2026-10-31: the generic kernel for copies past 2^31 elements that split_copy_32 cannot cut: 64-bit thread / element
+// numbers, plain 64-bit division (the 32-bit kernel cast the element number to uint32_t: wrong past 2^32 elements)
+__global__ void generic_strided_copy_kernel64(
+    const uint8_t* __restrict__ src,
+    uint8_t* __restrict__ dst,
+    int64_t total_elems,
+    const __grid_constant__ ContiguousMeta meta)
+{
+    const int64_t gstride = (int64_t)gridDim.x * blockDim.x * 4;
+    for (int64_t i_base = ((int64_t)blockIdx.x * blockDim.x + threadIdx.x) * 4; i_base < total_elems; i_base += gstride) {
+        for (int v = 0; v < 4; ++v) {
+            const int64_t i = i_base + v;
+            if (i >= total_elems) break;
+            uint64_t linear = (uint64_t)i;
+            int64_t elem_off = meta.storage_offset_elems;
+            for (int d = meta.ndim - 1; d >= 0; --d) {
+                const uint64_t dd = (uint64_t)meta.dims64[d];
+                const uint64_t q = linear / dd;
+                elem_off += (int64_t)(linear - q * dd) * meta.strides[d];
+                linear = q;
+            }
+            const int64_t src_byte = elem_off * meta.elem_size, dst_byte = i * meta.elem_size;
+            if (meta.elem_size == 4)
+                *reinterpret_cast<float*>(dst + dst_byte) = __ldg(reinterpret_cast<const float*>(src + src_byte));
+            else if (meta.elem_size == 8)
+                *reinterpret_cast<double*>(dst + dst_byte) = __ldg(reinterpret_cast<const double*>(src + src_byte));
+            else if (meta.elem_size == 2)
+                *reinterpret_cast<uint16_t*>(dst + dst_byte) = __ldg(reinterpret_cast<const uint16_t*>(src + src_byte));
+            else
+                for (int k = 0; k < meta.elem_size; ++k) dst[dst_byte + k] = src[src_byte + k];
+        }
+    }
+}
