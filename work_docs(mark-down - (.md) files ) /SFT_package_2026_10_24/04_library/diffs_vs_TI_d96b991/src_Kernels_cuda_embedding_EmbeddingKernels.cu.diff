+static void launch_embedding_backward_cooperative(
+    const uint16_t* indices, const void* grad_output, bool bf16_input, float* grad_weight,
+    int64_t N, int64_t C, int64_t V, int padding_idx) {
+    constexpr int SZ = 4;   // must match embedding_backward_kernel_cooperative's SZ
+    dim3 block(32, BLOCKDIMY);
+    dim3 grid((C + (32 * SZ) - 1) / (32 * SZ), 1);
+    const size_t smem = sizeof(float) * 32 * BLOCKDIMY + sizeof(int) * 32 * BLOCKDIMY;
+    if (bf16_input)
+        embedding_backward_kernel_cooperative<__nv_bfloat16><<<grid, block, smem>>>(
+            indices, static_cast<const __nv_bfloat16*>(grad_output), grad_weight, N, C, V, padding_idx);
+    else
+        embedding_backward_kernel_cooperative<float><<<grid, block, smem>>>(
+            indices, static_cast<const float*>(grad_output), grad_weight, N, C, V, padding_idx);
+}
