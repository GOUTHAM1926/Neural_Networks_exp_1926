+        const cudaError_t err = cudaPeekAtLastError();
+        if (err != cudaSuccess) {
+            throw std::runtime_error(std::string("cuda_accumulate_lowp_into_fp32: launch failed: ") +
+                                     cudaGetErrorString(err));
+        }
+        grad_accum::calls.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
